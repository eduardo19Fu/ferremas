<?xml version="1.0" encoding="UTF-8"?>
<!-- Proforma (cotizacion) en tamano carta. Mismo lenguaje visual del comprobante de venta. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="proforma" pageWidth="612" pageHeight="792" columnWidth="556" leftMargin="28" rightMargin="28" topMargin="28" bottomMargin="28">
	<parameter name="idProforma" class="java.lang.Long"/>
	<queryString>
		<![CDATA[SELECT cl.nombre,
        cl.nit,
        cl.direccion,
        cl.telefono,
        date_format(pr.fecha_emision, '%d/%m/%Y') AS fecha,
        pr.no_proforma,
        pr.total,
        p.nombre AS producto,
        p.cod_producto,
        prd.cantidad,
        prd.precio_unitario,
        prd.descuento,
        prd.sub_total_descuento,
        concat(us.primer_nombre, ' ', us.apellido) AS vendedor,
        get_numero_letras(pr.total) AS total_letras
FROM proformas AS pr
LEFT JOIN clientes AS cl ON cl.id_cliente = pr.id_cliente
INNER JOIN proformas_detalle AS prd ON prd.id_proforma = pr.id_proforma
LEFT JOIN productos AS p ON p.id_producto = prd.id_producto
LEFT JOIN usuarios AS us ON us.id_usuario = pr.id_usuario
WHERE pr.id_proforma = $P{idProforma}
ORDER BY prd.id_detalle]]>
	</queryString>
	<field name="nombre" class="java.lang.String"/>
	<field name="nit" class="java.lang.String"/>
	<field name="direccion" class="java.lang.String"/>
	<field name="telefono" class="java.lang.String"/>
	<field name="fecha" class="java.lang.String"/>
	<field name="no_proforma" class="java.lang.Long"/>
	<field name="total" class="java.math.BigDecimal"/>
	<field name="producto" class="java.lang.String"/>
	<field name="cod_producto" class="java.lang.String"/>
	<field name="cantidad" class="java.lang.Integer"/>
	<field name="precio_unitario" class="java.math.BigDecimal"/>
	<field name="descuento" class="java.lang.Float"/>
	<field name="sub_total_descuento" class="java.math.BigDecimal"/>
	<field name="vendedor" class="java.lang.String"/>
	<field name="total_letras" class="java.lang.String"/>

	<title>
		<band height="84">
			<!-- logotipo (version para fondo claro) -->
			<image scaleImage="RetainShape" hAlign="Left" vAlign="Top">
				<reportElement x="0" y="0" width="190" height="50"/>
				<imageExpression><![CDATA[this.getClass().getResourceAsStream("/static/images/reports-image/logo-ferremas.png")]]></imageExpression>
			</image>
			<staticText>
				<reportElement x="0" y="54" width="300" height="24" forecolor="#6B7280"/>
				<textElement verticalAlignment="Top">
					<font size="8"/>
				</textElement>
				<text><![CDATA[Aldea El Terrero Mataquescuintla, Jalapa
NIT: 34453148  ·  Teléfono: 50024143 - 31450819]]></text>
			</staticText>

			<!-- ficha del documento -->
			<rectangle radius="5">
				<reportElement x="376" y="2" width="180" height="70" forecolor="#DFE6EA" backcolor="#F4F8FA"/>
				<graphicElement>
					<pen lineWidth="0.75" lineColor="#DFE6EA"/>
				</graphicElement>
			</rectangle>
			<rectangle>
				<reportElement x="376" y="2" width="4" height="70" forecolor="#F4BE4A" backcolor="#F4BE4A"/>
				<graphicElement>
					<pen lineWidth="0.0"/>
				</graphicElement>
			</rectangle>
			<staticText>
				<reportElement x="390" y="9" width="160" height="11" forecolor="#227A99"/>
				<textElement>
					<font size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[PROFORMA]]></text>
			</staticText>
			<staticText>
				<reportElement x="390" y="23" width="30" height="24" forecolor="#6B7280"/>
				<textElement verticalAlignment="Bottom">
					<font size="10"/>
				</textElement>
				<text><![CDATA[No.]]></text>
			</staticText>
			<textField>
				<reportElement x="418" y="20" width="132" height="28" forecolor="#10303D"/>
				<textElement verticalAlignment="Middle">
					<font size="20" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{no_proforma}]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="390" y="52" width="158" height="1" forecolor="#DFE6EA"/>
				<graphicElement>
					<pen lineWidth="0.75" lineColor="#DFE6EA"/>
				</graphicElement>
			</line>
			<staticText>
				<reportElement x="390" y="55" width="80" height="14" forecolor="#6B7280"/>
				<textElement verticalAlignment="Middle">
					<font size="8"/>
				</textElement>
				<text><![CDATA[Fecha de emisión]]></text>
			</staticText>
			<textField>
				<reportElement x="470" y="55" width="78" height="14" forecolor="#10303D"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font size="9" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{fecha}]]></textFieldExpression>
			</textField>

			<!-- filete de marca -->
			<line>
				<reportElement x="0" y="80" width="556" height="1" forecolor="#E3E7EC"/>
				<graphicElement>
					<pen lineWidth="0.75" lineColor="#E3E7EC"/>
				</graphicElement>
			</line>
			<line>
				<reportElement x="0" y="80" width="64" height="1" forecolor="#F4BE4A"/>
				<graphicElement>
					<pen lineWidth="2.0" lineColor="#F4BE4A"/>
				</graphicElement>
			</line>
		</band>
	</title>
	<pageHeader>
		<band height="46" splitType="Stretch">
			<staticText>
				<reportElement x="0" y="6" width="52" height="12" forecolor="#6B7280"/>
				<textElement verticalAlignment="Middle">
					<font size="7" isBold="true"/>
				</textElement>
				<text><![CDATA[CLIENTE]]></text>
			</staticText>
			<textField isBlankWhenNull="true" textAdjust="StretchHeight">
				<reportElement x="56" y="5" width="330" height="14" forecolor="#10303D"/>
				<textElement verticalAlignment="Middle">
					<font size="9.5" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{nombre}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="400" y="6" width="30" height="12" forecolor="#6B7280"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font size="7" isBold="true"/>
				</textElement>
				<text><![CDATA[NIT]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="436" y="5" width="120" height="14" forecolor="#10303D"/>
				<textElement verticalAlignment="Middle">
					<font size="9"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{nit}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="20" width="52" height="12" forecolor="#6B7280"/>
				<textElement verticalAlignment="Middle">
					<font size="7" isBold="true"/>
				</textElement>
				<text><![CDATA[DIRECCIÓN]]></text>
			</staticText>
			<textField isBlankWhenNull="true" textAdjust="StretchHeight">
				<reportElement x="56" y="19" width="330" height="14" forecolor="#10303D"/>
				<textElement verticalAlignment="Middle">
					<font size="9"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{direccion}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="400" y="20" width="30" height="12" forecolor="#6B7280"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font size="7" isBold="true"/>
				</textElement>
				<text><![CDATA[TEL.]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="436" y="19" width="120" height="14" forecolor="#10303D"/>
				<textElement verticalAlignment="Middle">
					<font size="9"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{telefono}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="456" y="34" width="100" height="10" forecolor="#6B7280"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font size="7"/>
				</textElement>
				<textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
			</textField>
		</band>
	</pageHeader>
	<columnHeader>
		<band height="18">
			<rectangle radius="3">
				<reportElement x="0" y="0" width="556" height="18" forecolor="#10303D" backcolor="#10303D"/>
				<graphicElement>
					<pen lineWidth="0.0"/>
				</graphicElement>
			</rectangle>
			<staticText>
				<reportElement x="4" y="1" width="40" height="16" forecolor="#FFFFFF"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[CANT.]]></text>
			</staticText>
			<staticText>
				<reportElement x="52" y="1" width="260" height="16" forecolor="#FFFFFF"/>
				<textElement verticalAlignment="Middle">
					<font size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[PRODUCTO]]></text>
			</staticText>
			<staticText>
				<reportElement x="316" y="1" width="70" height="16" forecolor="#FFFFFF"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[PRECIO]]></text>
			</staticText>
			<staticText>
				<reportElement x="392" y="1" width="50" height="16" forecolor="#FFFFFF"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[DESC.]]></text>
			</staticText>
			<staticText>
				<reportElement x="448" y="1" width="100" height="16" forecolor="#FFFFFF"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[SUBTOTAL]]></text>
			</staticText>
		</band>
	</columnHeader>
	<detail>
		<band height="20">
			<textField>
				<reportElement x="4" y="2" width="40" height="16" forecolor="#10303D"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="8.5"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{cantidad}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true" textAdjust="StretchHeight">
				<reportElement x="52" y="2" width="260" height="16" isPrintWhenDetailOverflows="true" forecolor="#10303D"/>
				<textElement verticalAlignment="Middle">
					<font size="8.5"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{producto} == null ? "Producto no disponible" : $F{producto}]]></textFieldExpression>
			</textField>
			<textField pattern="Q#,##0.00;¤-#,##0.00" isBlankWhenNull="true">
				<reportElement x="316" y="2" width="70" height="16" forecolor="#10303D"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font size="8.5"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{precio_unitario}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="392" y="2" width="50" height="16" forecolor="#6B7280"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font size="8.5"/>
				</textElement>
				<textFieldExpression><![CDATA[($F{descuento} == null || $F{descuento}.floatValue() == 0f) ? "—" : new java.text.DecimalFormat("#,##0.##").format($F{descuento}) + "%"]]></textFieldExpression>
			</textField>
			<textField pattern="Q#,##0.00;¤-#,##0.00">
				<reportElement x="448" y="2" width="100" height="16" forecolor="#10303D"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font size="8.5" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{sub_total_descuento}]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="0" y="19" width="556" height="1" forecolor="#EEF0F3"/>
				<graphicElement>
					<pen lineWidth="0.5" lineColor="#EEF0F3"/>
				</graphicElement>
			</line>
		</band>
	</detail>
	<columnFooter>
		<band splitType="Stretch"/>
	</columnFooter>
	<pageFooter>
		<band splitType="Stretch"/>
	</pageFooter>
	<lastPageFooter>
		<band height="96">
			<rectangle radius="4">
				<reportElement x="0" y="4" width="556" height="28" forecolor="#DFE6EA" backcolor="#F4F8FA"/>
				<graphicElement>
					<pen lineWidth="0.75" lineColor="#DFE6EA"/>
				</graphicElement>
			</rectangle>
			<rectangle>
				<reportElement x="0" y="4" width="4" height="28" forecolor="#F4BE4A" backcolor="#F4BE4A"/>
				<graphicElement>
					<pen lineWidth="0.0"/>
				</graphicElement>
			</rectangle>
			<staticText>
				<reportElement x="12" y="12" width="26" height="12" forecolor="#6B7280"/>
				<textElement verticalAlignment="Middle">
					<font size="7" isBold="true"/>
				</textElement>
				<text><![CDATA[SON:]]></text>
			</staticText>
			<textField isBlankWhenNull="true" textAdjust="StretchHeight">
				<reportElement x="38" y="10" width="330" height="16" forecolor="#10303D"/>
				<textElement verticalAlignment="Middle">
					<font size="8.5"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{total_letras}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="372" y="11" width="52" height="14" forecolor="#6B7280"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[TOTAL]]></text>
			</staticText>
			<textField pattern="Q#,##0.00;¤-#,##0.00">
				<reportElement x="428" y="7" width="120" height="22" forecolor="#10303D"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font size="14" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{total}]]></textFieldExpression>
			</textField>

			<!-- firma del vendedor -->
			<line>
				<reportElement x="0" y="76" width="190" height="1" forecolor="#9AA5B1"/>
				<graphicElement>
					<pen lineWidth="0.75" lineColor="#9AA5B1"/>
				</graphicElement>
			</line>
			<staticText>
				<reportElement x="0" y="79" width="40" height="12" forecolor="#6B7280"/>
				<textElement verticalAlignment="Middle">
					<font size="7" isBold="true"/>
				</textElement>
				<text><![CDATA[VENDEDOR]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="46" y="79" width="144" height="12" forecolor="#10303D"/>
				<textElement verticalAlignment="Middle">
					<font size="8.5"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{vendedor}]]></textFieldExpression>
			</textField>
		</band>
	</lastPageFooter>
</jasperReport>
