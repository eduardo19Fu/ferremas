<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="productos_mas_vendidos" whenNoDataType="NoDataSection" pageWidth="612" pageHeight="792" columnWidth="572" leftMargin="20" rightMargin="20" topMargin="24" bottomMargin="24" uuid="521ec794-8f0d-4c29-810a-8a123236ce92">
	<style name="fila" mode="Transparent" fontName="SansSerif" fontSize="8" vAlign="Middle">
		<conditionalStyle><conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression><style mode="Opaque" backcolor="#FFF4E5"/></conditionalStyle>
	</style>
	<parameter name="FECHA_INICIO" class="java.sql.Timestamp"/>
	<parameter name="FECHA_FIN_EXCLUSIVA" class="java.sql.Timestamp"/>
	<parameter name="LIMITE" class="java.lang.Integer"/>
	<parameter name="ORDEN" class="java.lang.String"/>
	<parameter name="RANGO" class="java.lang.String"/>
	<queryString language="SQL"><![CDATA[SELECT p.cod_producto AS COD, p.nombre AS NOMBRE, COALESCE(mc.marca, '') AS MARCA,
       CAST(SUM(v.cantidad) AS SIGNED) AS CANTIDAD,
       CAST(SUM(v.importe) AS DECIMAL(14,2)) AS IMPORTE,
       CAST(COUNT(DISTINCT v.doc) AS SIGNED) AS DOCUMENTOS,
       DATE_FORMAT(MAX(v.fecha), '%d/%m/%Y') AS ULTIMA,
       CAST(COALESCE(p.stock, 0) AS SIGNED) AS STOCK
  FROM (SELECT d.id_producto, d.cantidad, COALESCE(d.sub_total_descuento, d.sub_total, 0) AS importe, f.fecha AS fecha, CONCAT('F', f.id_factura) AS doc
                 FROM facturas_detalle d
                INNER JOIN facturas f ON f.id_factura = d.id_factura
                INNER JOIN estados e ON e.id_estado = f.id_estado
                WHERE e.estado <> 'ANULADO' AND f.fecha >= $P{FECHA_INICIO} AND f.fecha < $P{FECHA_FIN_EXCLUSIVA}
               UNION ALL
               SELECT d.id_producto, d.cantidad, COALESCE(d.sub_total_descuento, d.sub_total, 0), n.fecha_creacion, CONCAT('N', n.id_nota_credito)
                 FROM notas_credito_detalle d
                INNER JOIN notas_credito n ON n.id_nota_credito = d.id_nota_credito
                INNER JOIN estados e ON e.id_estado = n.id_estado
                WHERE e.estado <> 'ANULADO' AND n.fecha_creacion >= $P{FECHA_INICIO} AND n.fecha_creacion < $P{FECHA_FIN_EXCLUSIVA}) v
 INNER JOIN productos p ON p.id_producto = v.id_producto
  LEFT JOIN marcas_producto mc ON mc.id_marca_producto = p.id_marca_producto
 GROUP BY p.id_producto, p.cod_producto, p.nombre, mc.marca, p.stock
 ORDER BY CASE WHEN $P{ORDEN} = 'IMPORTE' THEN SUM(v.importe) ELSE SUM(v.cantidad) END DESC, SUM(v.importe) DESC
 LIMIT $P{LIMITE}]]></queryString>
	<field name="COD" class="java.lang.String"/>
	<field name="NOMBRE" class="java.lang.String"/>
	<field name="MARCA" class="java.lang.String"/>
	<field name="CANTIDAD" class="java.lang.Long"/>
	<field name="IMPORTE" class="java.math.BigDecimal"/>
	<field name="DOCUMENTOS" class="java.lang.Long"/>
	<field name="ULTIMA" class="java.lang.String"/>
	<field name="STOCK" class="java.lang.Long"/>
	<variable name="totUnidades" class="java.lang.Long" calculation="Sum"><variableExpression><![CDATA[$F{CANTIDAD}]]></variableExpression></variable>
	<variable name="totImporte" class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{IMPORTE}]]></variableExpression></variable>
	<title>
