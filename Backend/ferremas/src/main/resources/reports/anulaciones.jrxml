<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="anulaciones" whenNoDataType="NoDataSection" pageWidth="612" pageHeight="792" columnWidth="572" leftMargin="20" rightMargin="20" topMargin="24" bottomMargin="24" uuid="4349cc80-a855-40be-86aa-6223edecb106">
	<style name="fila" mode="Transparent" fontName="SansSerif" fontSize="8" vAlign="Middle">
		<conditionalStyle><conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression><style mode="Opaque" backcolor="#FDECEC"/></conditionalStyle>
	</style>
	<parameter name="FECHA_INICIO" class="java.sql.Timestamp"/>
	<parameter name="FECHA_FIN_EXCLUSIVA" class="java.sql.Timestamp"/>
	<parameter name="RANGO" class="java.lang.String"/>
	<queryString language="SQL"><![CDATA[SELECT x.DOCUMENTO AS DOCUMENTO, x.NUMERO AS NUMERO, DATE_FORMAT(x.fecha, '%d/%m/%Y %H:%i') AS FECHA,
       x.TERCERO AS TERCERO, x.USUARIO AS USUARIO, x.TOTAL AS TOTAL
  FROM (
        SELECT 'Facturas' AS DOCUMENTO, CONCAT(COALESCE(f.serie, ''), '-', COALESCE(f.no_factura, '')) AS NUMERO, f.fecha AS fecha,
               COALESCE(c.nombre, 'Consumidor final') AS TERCERO,
               TRIM(CONCAT(COALESCE(u.primer_nombre, ''), ' ', COALESCE(u.apellido, ''))) AS USUARIO,
               CAST(COALESCE(f.total, 0) AS DECIMAL(14,2)) AS TOTAL
          FROM facturas f
         INNER JOIN estados e ON e.id_estado = f.id_estado
          LEFT JOIN clientes c ON c.id_cliente = f.id_cliente
          LEFT JOIN usuarios u ON u.id_usuario = f.id_usuario
         WHERE e.estado = 'ANULADO' AND f.fecha >= $P{FECHA_INICIO} AND f.fecha < $P{FECHA_FIN_EXCLUSIVA}
        UNION ALL
        SELECT 'Notas de crédito', CONCAT('NC-', n.id_nota_credito), n.fecha_creacion,
               COALESCE(c.nombre, ''),
               TRIM(CONCAT(COALESCE(u.primer_nombre, ''), ' ', COALESCE(u.apellido, ''))),
               CAST(COALESCE(n.total, 0) AS DECIMAL(14,2))
          FROM notas_credito n
         INNER JOIN estados e ON e.id_estado = n.id_estado
          LEFT JOIN clientes c ON c.id_cliente = n.id_cliente
          LEFT JOIN usuarios u ON u.id_usuario = n.id_usuario
         WHERE e.estado = 'ANULADO' AND n.fecha_creacion >= $P{FECHA_INICIO} AND n.fecha_creacion < $P{FECHA_FIN_EXCLUSIVA}
        UNION ALL
        SELECT 'Compras', COALESCE(co.no_comprobante, ''), CAST(co.fecha_compra AS DATETIME),
               COALESCE(pr.nombre, ''),
               TRIM(CONCAT(COALESCE(u.primer_nombre, ''), ' ', COALESCE(u.apellido, ''))),
               CAST(COALESCE(co.total_compra, 0) AS DECIMAL(14,2))
          FROM compras co
         INNER JOIN estados e ON e.id_estado = co.id_estado
          LEFT JOIN proveedores pr ON pr.id_proveedor = co.id_proveedor
          LEFT JOIN usuarios u ON u.id_usuario = co.id_usuario
         WHERE e.estado = 'ANULADO' AND co.fecha_compra >= $P{FECHA_INICIO} AND co.fecha_compra < $P{FECHA_FIN_EXCLUSIVA}
       ) x
 ORDER BY FIELD(x.DOCUMENTO, 'Facturas', 'Notas de crédito', 'Compras'), x.fecha]]></queryString>
	<field name="DOCUMENTO" class="java.lang.String"/>
	<field name="NUMERO" class="java.lang.String"/>
	<field name="FECHA" class="java.lang.String"/>
	<field name="TERCERO" class="java.lang.String"/>
	<field name="USUARIO" class="java.lang.String"/>
	<field name="TOTAL" class="java.math.BigDecimal"/>
	<variable name="totAnulado" class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{TOTAL}]]></variableExpression></variable>
	<variable name="subTipo" class="java.math.BigDecimal" calculation="Sum" resetType="Group" resetGroup="g_tipo"><variableExpression><![CDATA[$F{TOTAL}]]></variableExpression></variable>
	<group name="g_tipo"><groupExpression><![CDATA[$F{DOCUMENTO}]]></groupExpression>
