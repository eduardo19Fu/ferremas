<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="compras_periodo" whenNoDataType="NoDataSection" pageWidth="612" pageHeight="792" columnWidth="572" leftMargin="20" rightMargin="20" topMargin="24" bottomMargin="24" uuid="c81de278-91ce-408c-8064-9b46d08ca2fa">
	<style name="fila" mode="Transparent" fontName="SansSerif" fontSize="8" vAlign="Middle">
		<conditionalStyle><conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression><style mode="Opaque" backcolor="#F1EAFD"/></conditionalStyle>
	</style>
	<parameter name="FECHA_INICIO" class="java.sql.Timestamp"/>
	<parameter name="FECHA_FIN_EXCLUSIVA" class="java.sql.Timestamp"/>
	<parameter name="ID_PROVEEDOR" class="java.lang.Integer"/>
	<parameter name="PROVEEDOR_TXT" class="java.lang.String"/>
	<parameter name="RANGO" class="java.lang.String"/>
	<queryString language="SQL"><![CDATA[SELECT COALESCE(pr.nombre, 'Sin proveedor') AS PROVEEDOR,
       DATE_FORMAT(c.fecha_compra, '%d/%m/%Y') AS FECHA,
       COALESCE(c.no_comprobante, '') AS COMPROBANTE,
       COALESCE(tc.tipo_comprobante, '') AS TIPO,
       TRIM(CONCAT(COALESCE(u.primer_nombre, ''), ' ', COALESCE(u.apellido, ''))) AS USUARIO,
       CAST(COALESCE(c.total_compra, 0) AS DECIMAL(14,2)) AS TOTAL
  FROM compras c
 INNER JOIN estados e ON e.id_estado = c.id_estado
  LEFT JOIN proveedores pr ON pr.id_proveedor = c.id_proveedor
  LEFT JOIN tipos_comprobante tc ON tc.id_tipo_comprobante = c.id_tipo_comprobante
  LEFT JOIN usuarios u ON u.id_usuario = c.id_usuario
 WHERE e.estado <> 'ANULADO'
   AND c.fecha_compra >= $P{FECHA_INICIO} AND c.fecha_compra < $P{FECHA_FIN_EXCLUSIVA}
   AND ($P{ID_PROVEEDOR} = 0 OR c.id_proveedor = $P{ID_PROVEEDOR})
 ORDER BY PROVEEDOR, c.fecha_compra, c.id_compra]]></queryString>
	<field name="PROVEEDOR" class="java.lang.String"/>
	<field name="FECHA" class="java.lang.String"/>
	<field name="COMPROBANTE" class="java.lang.String"/>
	<field name="TIPO" class="java.lang.String"/>
	<field name="USUARIO" class="java.lang.String"/>
	<field name="TOTAL" class="java.math.BigDecimal"/>
	<variable name="totCompras" class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{TOTAL}]]></variableExpression></variable>
	<variable name="subProveedor" class="java.math.BigDecimal" calculation="Sum" resetType="Group" resetGroup="g_proveedor"><variableExpression><![CDATA[$F{TOTAL}]]></variableExpression></variable>
	<group name="g_proveedor"><groupExpression><![CDATA[$F{PROVEEDOR}]]></groupExpression>
