<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="cuentas_por_cobrar" whenNoDataType="NoDataSection" pageWidth="612" pageHeight="792" columnWidth="572" leftMargin="20" rightMargin="20" topMargin="24" bottomMargin="24" uuid="09ca718f-a4a4-4bc0-8f63-50f90f89f161">
	<style name="fila" mode="Transparent" fontName="SansSerif" fontSize="8" vAlign="Middle">
		<conditionalStyle><conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression><style mode="Opaque" backcolor="#E6F4F2"/></conditionalStyle>
	</style>
	<parameter name="ID_CLIENTE" class="java.lang.Integer"/>
	<parameter name="SOLO_VENCIDAS" class="java.lang.Integer"/>
	<parameter name="CLIENTE_TXT" class="java.lang.String"/>
	<parameter name="HOY_TXT" class="java.lang.String"/>
	<queryString language="SQL"><![CDATA[SELECT COALESCE(c.nombre, 'Sin cliente') AS CLIENTE,
       CAST(n.id_nota_credito AS SIGNED) AS NOTA,
       DATE_FORMAT(n.fecha_creacion, '%d/%m/%Y') AS EMISION,
       COALESCE(DATE_FORMAT(n.fecha_pago_limite, '%d/%m/%Y'), '—') AS LIMITE,
       CAST(COALESCE(n.total, 0) AS DECIMAL(14,2)) AS TOTAL,
       CAST(COALESCE(n.total, 0) - COALESCE(n.restante, 0) AS DECIMAL(14,2)) AS ABONADO,
       CAST(COALESCE(n.restante, 0) AS DECIMAL(14,2)) AS SALDO,
       CAST(CASE WHEN n.fecha_pago_limite IS NULL THEN 0 ELSE GREATEST(DATEDIFF(CURDATE(), n.fecha_pago_limite), 0) END AS SIGNED) AS DIAS
  FROM notas_credito n
 INNER JOIN estados e ON e.id_estado = n.id_estado
  LEFT JOIN clientes c ON c.id_cliente = n.id_cliente
 WHERE e.estado <> 'ANULADO' AND COALESCE(n.restante, 0) > 0.004
   AND ($P{ID_CLIENTE} = 0 OR n.id_cliente = $P{ID_CLIENTE})
   AND ($P{SOLO_VENCIDAS} = 0 OR n.fecha_pago_limite < CURDATE())
 ORDER BY CLIENTE, n.fecha_pago_limite, n.id_nota_credito]]></queryString>
	<field name="CLIENTE" class="java.lang.String"/>
	<field name="NOTA" class="java.lang.Long"/>
	<field name="EMISION" class="java.lang.String"/>
	<field name="LIMITE" class="java.lang.String"/>
	<field name="TOTAL" class="java.math.BigDecimal"/>
	<field name="ABONADO" class="java.math.BigDecimal"/>
	<field name="SALDO" class="java.math.BigDecimal"/>
	<field name="DIAS" class="java.lang.Long"/>
	<variable name="totSaldo" class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{SALDO}]]></variableExpression></variable>
	<variable name="totVencido" class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{DIAS} > 0 ? $F{SALDO} : java.math.BigDecimal.ZERO]]></variableExpression></variable>
	<variable name="totVigente" class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{DIAS} > 0 ? java.math.BigDecimal.ZERO : $F{SALDO}]]></variableExpression></variable>
	<variable name="subCliente" class="java.math.BigDecimal" calculation="Sum" resetType="Group" resetGroup="g_cliente"><variableExpression><![CDATA[$F{SALDO}]]></variableExpression></variable>
	<group name="g_cliente"><groupExpression><![CDATA[$F{CLIENTE}]]></groupExpression>
