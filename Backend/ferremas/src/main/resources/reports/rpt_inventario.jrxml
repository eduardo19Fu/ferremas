<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rpt_inventario" pageWidth="612" pageHeight="792" columnWidth="572" leftMargin="20" rightMargin="20" topMargin="24" bottomMargin="24" uuid="a2690769-32ca-46b0-91ac-46f20d1f748d">
	<!-- Inventario valorizado con los movimientos del dia indicado en pFecha. -->
	<style name="fila" mode="Transparent" fontName="SansSerif" fontSize="8" vAlign="Middle">
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression>
			<style mode="Opaque" backcolor="#FFF3EA"/>
		</conditionalStyle>
	</style>
	<style name="stock" style="fila" isBold="true">
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{STOCK} <= 0]]></conditionExpression>
			<style forecolor="#C62828"/>
		</conditionalStyle>
	</style>
	<parameter name="pFecha" class="java.util.Date"/>
	<queryString language="SQL">
		<![CDATA[SELECT pr.cod_producto AS COD_PRODUCTO,
       pr.nombre AS NOMBRE,
       mc.marca AS MARCA,
       IFNULL(pr.precio_venta, 0) AS PRE_VENTA,
       CAST(IFNULL(pr.stock, 0) AS SIGNED) AS STOCK,
       CAST(IFNULL((SELECT SUM(movp.cantidad) FROM movimientos_producto AS movp
                     WHERE movp.id_producto = pr.id_producto
                       AND movp.id_tipo_movimiento IN (2,4,5)
                       AND DATE(movp.fecha_movimiento) = $P{pFecha}), 0) AS SIGNED) AS ENTRADAS,
       CAST(IFNULL((SELECT SUM(movp.cantidad) FROM movimientos_producto AS movp
                     WHERE movp.id_producto = pr.id_producto
                       AND movp.id_tipo_movimiento IN (1,6)
                       AND DATE(movp.fecha_movimiento) = $P{pFecha}), 0) AS SIGNED) AS SALIDAS,
       IFNULL(pr.stock, 0) * IFNULL(pr.precio_venta, 0) AS VALOR
  FROM productos AS pr
 INNER JOIN marcas_producto AS mc ON mc.id_marca_producto = pr.id_marca_producto
 ORDER BY pr.nombre ASC]]>
	</queryString>
	<field name="COD_PRODUCTO" class="java.lang.String"/>
	<field name="NOMBRE" class="java.lang.String"/>
	<field name="MARCA" class="java.lang.String"/>
	<field name="PRE_VENTA" class="java.math.BigDecimal"/>
	<field name="STOCK" class="java.lang.Long"/>
	<field name="ENTRADAS" class="java.lang.Long"/>
	<field name="SALIDAS" class="java.lang.Long"/>
	<field name="VALOR" class="java.math.BigDecimal"/>
	<variable name="totStock" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{STOCK}]]></variableExpression>
	</variable>
	<variable name="totEntradas" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{ENTRADAS}]]></variableExpression>
	</variable>
	<variable name="totSalidas" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{SALIDAS}]]></variableExpression>
	</variable>
	<variable name="totValor" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{VALOR}]]></variableExpression>
	</variable>
	<variable name="sinStock" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{STOCK} <= 0 ? 1 : 0]]></variableExpression>
	</variable>
