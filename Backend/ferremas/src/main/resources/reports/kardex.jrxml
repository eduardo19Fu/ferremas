<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="kardex" whenNoDataType="AllSectionsNoDetail" pageWidth="612" pageHeight="792" columnWidth="572" leftMargin="20" rightMargin="20" topMargin="24" bottomMargin="24" uuid="407c29d4-07b9-438e-8747-2833ce8579fa">
	<style name="fila" mode="Transparent" fontName="SansSerif" fontSize="8" vAlign="Middle">
		<conditionalStyle><conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression><style mode="Opaque" backcolor="#ECEEF9"/></conditionalStyle>
	</style>
	<parameter name="FECHA_INICIO" class="java.sql.Timestamp"/>
	<parameter name="FECHA_FIN_EXCLUSIVA" class="java.sql.Timestamp"/>
	<parameter name="ID_PRODUCTO" class="java.lang.Integer"/>
	<parameter name="PRODUCTO_TXT" class="java.lang.String"/>
	<parameter name="APERTURA" class="java.lang.Integer"/>
	<parameter name="TIPOS_ENTRADA_TXT" class="java.lang.String"/>
	<parameter name="RANGO" class="java.lang.String"/>
	<queryString language="SQL"><![CDATA[SELECT DATE_FORMAT(m.fecha_movimiento, '%d/%m/%Y %H:%i') AS FECHA,
       COALESCE(t.tipo_movimiento, '') AS TIPO,
       TRIM(CONCAT(COALESCE(u.primer_nombre, ''), ' ', COALESCE(u.apellido, ''))) AS USUARIO,
       CAST(CASE WHEN UPPER(t.tipo_movimiento) IN ($P!{TIPOS_ENTRADA_TXT}) THEN m.cantidad ELSE 0 END AS SIGNED) AS ENTRADA,
       CAST(CASE WHEN UPPER(t.tipo_movimiento) IN ($P!{TIPOS_ENTRADA_TXT}) THEN 0 ELSE m.cantidad END AS SIGNED) AS SALIDA
  FROM movimientos_producto m
  LEFT JOIN tipos_movimiento t ON t.id_tipo_movimiento = m.id_tipo_movimiento
  LEFT JOIN usuarios u ON u.id_usuario = m.id_usuario
 WHERE m.id_producto = $P{ID_PRODUCTO}
   AND m.fecha_movimiento >= $P{FECHA_INICIO} AND m.fecha_movimiento < $P{FECHA_FIN_EXCLUSIVA}
 ORDER BY m.fecha_movimiento, m.id_movimiento]]></queryString>
	<field name="FECHA" class="java.lang.String"/>
	<field name="TIPO" class="java.lang.String"/>
	<field name="USUARIO" class="java.lang.String"/>
	<field name="ENTRADA" class="java.lang.Long"/>
	<field name="SALIDA" class="java.lang.Long"/>
	<variable name="totEntradas" class="java.lang.Long" calculation="Sum"><variableExpression><![CDATA[$F{ENTRADA}]]></variableExpression></variable>
	<variable name="totSalidas" class="java.lang.Long" calculation="Sum"><variableExpression><![CDATA[$F{SALIDA}]]></variableExpression></variable>
	<title>
