<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ventas_diarias" whenNoDataType="NoDataSection" pageWidth="612" pageHeight="792" columnWidth="572" leftMargin="20" rightMargin="20" topMargin="24" bottomMargin="24" uuid="c3a9d1f2-5b7e-4c11-9a0d-7e2f6b8c4d10">
	<!-- Facturas vigentes (no anuladas) emitidas en un dia, de todos los vendedores o de uno. -->
	<style name="fila" mode="Transparent" fontName="SansSerif" fontSize="8" vAlign="Middle">
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression>
			<style mode="Opaque" backcolor="#EEF8F1"/>
		</conditionalStyle>
	</style>
	<parameter name="FECHA_INICIO" class="java.sql.Timestamp"/>
	<parameter name="FECHA_FIN_EXCLUSIVA" class="java.sql.Timestamp"/>
	<parameter name="ID_USUARIO" class="java.lang.Integer"/>
	<parameter name="FECHA_TXT" class="java.lang.String"/>
	<parameter name="VENDEDOR_TXT" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT CONCAT(COALESCE(f.serie, ''), '-', COALESCE(f.no_factura, '')) AS FACTURA,
       DATE_FORMAT(f.fecha, '%H:%i') AS HORA,
       COALESCE(c.nombre, 'Consumidor final') AS CLIENTE,
       TRIM(CONCAT(COALESCE(u.primer_nombre, ''), ' ', COALESCE(u.apellido, ''))) AS VENDEDOR,
       COALESCE(t.tipo_factura, '') AS TIPO,
       CAST(COALESCE(f.total, 0) AS DECIMAL(14,2)) AS TOTAL
  FROM facturas f
 INNER JOIN estados e ON e.id_estado = f.id_estado
 INNER JOIN usuarios u ON u.id_usuario = f.id_usuario
  LEFT JOIN clientes c ON c.id_cliente = f.id_cliente
  LEFT JOIN tipos_factura t ON t.id_tipo_factura = f.id_tipo_factura
 WHERE e.estado <> 'ANULADO'
   AND f.fecha >= $P{FECHA_INICIO}
   AND f.fecha < $P{FECHA_FIN_EXCLUSIVA}
   AND ($P{ID_USUARIO} = 0 OR f.id_usuario = $P{ID_USUARIO})
 ORDER BY f.fecha ASC, f.id_factura ASC]]>
	</queryString>
	<field name="FACTURA" class="java.lang.String"/>
	<field name="HORA" class="java.lang.String"/>
	<field name="CLIENTE" class="java.lang.String"/>
	<field name="VENDEDOR" class="java.lang.String"/>
	<field name="TIPO" class="java.lang.String"/>
	<field name="TOTAL" class="java.math.BigDecimal"/>
	<variable name="totVentas" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{TOTAL}]]></variableExpression>
	</variable>
