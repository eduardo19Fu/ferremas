<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="productos_baja_rotacion" whenNoDataType="NoDataSection" pageWidth="612" pageHeight="792" columnWidth="572" leftMargin="20" rightMargin="20" topMargin="24" bottomMargin="24" uuid="26397b01-fc49-47b9-8667-58656f3a59f9">
	<style name="fila" mode="Transparent" fontName="SansSerif" fontSize="8" vAlign="Middle">
		<conditionalStyle><conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression><style mode="Opaque" backcolor="#FDECE4"/></conditionalStyle>
	</style>
	<parameter name="FECHA_INICIO" class="java.sql.Timestamp"/>
	<parameter name="FECHA_FIN_EXCLUSIVA" class="java.sql.Timestamp"/>
	<parameter name="UMBRAL" class="java.lang.Integer"/>
	<parameter name="LIMITE" class="java.lang.Integer"/>
	<parameter name="RANGO" class="java.lang.String"/>
	<queryString language="SQL"><![CDATA[SELECT p.cod_producto AS COD, p.nombre AS NOMBRE, COALESCE(mc.marca, '') AS MARCA,
       CAST(COALESCE(p.stock, 0) AS SIGNED) AS STOCK,
       CAST(COALESCE(SUM(CASE WHEN v.fecha >= $P{FECHA_INICIO} AND v.fecha < $P{FECHA_FIN_EXCLUSIVA} THEN v.cantidad END), 0) AS SIGNED) AS VENDIDO,
       COALESCE(DATE_FORMAT(MAX(v.fecha), '%d/%m/%Y'), 'Nunca') AS ULTIMA,
       CAST(COALESCE(p.stock, 0) * COALESCE(p.precio_compra, 0) AS DECIMAL(14,2)) AS VALOR
  FROM productos p
  LEFT JOIN estados ep ON ep.id_estado = p.id_estado
  LEFT JOIN marcas_producto mc ON mc.id_marca_producto = p.id_marca_producto
  LEFT JOIN (SELECT d.id_producto, d.cantidad, f.fecha
               FROM facturas_detalle d
              INNER JOIN facturas f ON f.id_factura = d.id_factura
              INNER JOIN estados e ON e.id_estado = f.id_estado
              WHERE e.estado <> 'ANULADO'
             UNION ALL
             SELECT d.id_producto, d.cantidad, n.fecha_creacion
               FROM notas_credito_detalle d
              INNER JOIN notas_credito n ON n.id_nota_credito = d.id_nota_credito
              INNER JOIN estados e ON e.id_estado = n.id_estado
              WHERE e.estado <> 'ANULADO') v ON v.id_producto = p.id_producto
 WHERE COALESCE(ep.estado, 'ACTIVO') = 'ACTIVO' AND p.stock > 0
 GROUP BY p.id_producto, p.cod_producto, p.nombre, mc.marca, p.stock, p.precio_compra
HAVING COALESCE(SUM(CASE WHEN v.fecha >= $P{FECHA_INICIO} AND v.fecha < $P{FECHA_FIN_EXCLUSIVA} THEN v.cantidad END), 0) <= $P{UMBRAL}
 ORDER BY VALOR DESC
 LIMIT $P{LIMITE}]]></queryString>
	<field name="COD" class="java.lang.String"/>
	<field name="NOMBRE" class="java.lang.String"/>
	<field name="MARCA" class="java.lang.String"/>
	<field name="STOCK" class="java.lang.Long"/>
	<field name="VENDIDO" class="java.lang.Long"/>
	<field name="ULTIMA" class="java.lang.String"/>
	<field name="VALOR" class="java.math.BigDecimal"/>
	<variable name="totStock" class="java.lang.Long" calculation="Sum"><variableExpression><![CDATA[$F{STOCK}]]></variableExpression></variable>
	<variable name="totValor" class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{VALOR}]]></variableExpression></variable>
