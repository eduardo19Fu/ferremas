				<textFieldExpression><![CDATA[$V{totFacturas} == 0L ? java.math.BigDecimal.ZERO : $V{totVentas}.divide(new java.math.BigDecimal($V{totFacturas}), 2, java.math.RoundingMode.HALF_UP)]]></textFieldExpression>
