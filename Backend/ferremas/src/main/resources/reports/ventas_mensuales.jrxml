<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ventas_mensuales" whenNoDataType="AllSectionsNoDetail" pageWidth="612" pageHeight="792" columnWidth="572" leftMargin="20" rightMargin="20" topMargin="24" bottomMargin="24" uuid="f4b8e2a1-6c3d-4d22-8b1e-9a7c5d3e1f20">
	<!-- Ventas vigentes (facturas no anuladas) por mes de un anio, de todos los vendedores o de uno. Siempre lista los 12 meses. -->
	<style name="fila" mode="Transparent" fontName="SansSerif" fontSize="9" vAlign="Middle">
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression>
			<style mode="Opaque" backcolor="#EAF4F8"/>
		</conditionalStyle>
	</style>
	<parameter name="FECHA_INICIO" class="java.sql.Timestamp"/>
	<parameter name="FECHA_FIN_EXCLUSIVA" class="java.sql.Timestamp"/>
	<parameter name="ID_USUARIO" class="java.lang.Integer"/>
	<parameter name="ANIO" class="java.lang.Integer"/>
	<parameter name="VENDEDOR_TXT" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT CAST(m.mes AS SIGNED) AS MES,
       CAST(COALESCE(x.n, 0) AS SIGNED) AS FACTURAS,
       CAST(COALESCE(x.t, 0) AS DECIMAL(14,2)) AS TOTAL,
       CAST(CASE WHEN COALESCE(x.n, 0) = 0 THEN 0 ELSE x.t / x.n END AS DECIMAL(14,2)) AS PROMEDIO,
       CAST(CASE WHEN a.total = 0 THEN 0 ELSE COALESCE(x.t, 0) * 100 / a.total END AS DECIMAL(6,2)) AS PARTICIPACION,
       CAST(CASE WHEN a.maximo = 0 THEN 0 ELSE COALESCE(x.t, 0) * 100 / a.maximo END AS DECIMAL(6,2)) AS BARRA
  FROM (SELECT 1 AS mes UNION ALL SELECT 2 UNION ALL SELECT 3 UNION ALL SELECT 4 UNION ALL SELECT 5 UNION ALL SELECT 6
        UNION ALL SELECT 7 UNION ALL SELECT 8 UNION ALL SELECT 9 UNION ALL SELECT 10 UNION ALL SELECT 11 UNION ALL SELECT 12) m
  LEFT JOIN (SELECT MONTH(f1.fecha) AS mes, COUNT(*) AS n, SUM(f1.total) AS t
               FROM facturas f1
              INNER JOIN estados e1 ON e1.id_estado = f1.id_estado
              WHERE e1.estado <> 'ANULADO'
                AND f1.fecha >= $P{FECHA_INICIO} AND f1.fecha < $P{FECHA_FIN_EXCLUSIVA}
                AND ($P{ID_USUARIO} = 0 OR f1.id_usuario = $P{ID_USUARIO})
              GROUP BY MONTH(f1.fecha)) x ON x.mes = m.mes
 CROSS JOIN (SELECT COALESCE(SUM(s.t), 0) AS total, COALESCE(MAX(s.t), 0) AS maximo
               FROM (SELECT SUM(f2.total) AS t
                       FROM facturas f2
                      INNER JOIN estados e2 ON e2.id_estado = f2.id_estado
                      WHERE e2.estado <> 'ANULADO'
                        AND f2.fecha >= $P{FECHA_INICIO} AND f2.fecha < $P{FECHA_FIN_EXCLUSIVA}
                        AND ($P{ID_USUARIO} = 0 OR f2.id_usuario = $P{ID_USUARIO})
                      GROUP BY MONTH(f2.fecha)) s) a
 ORDER BY m.mes]]>
	</queryString>
	<field name="MES" class="java.lang.Long"/>
	<field name="FACTURAS" class="java.lang.Long"/>
	<field name="TOTAL" class="java.math.BigDecimal"/>
	<field name="PROMEDIO" class="java.math.BigDecimal"/>
	<field name="PARTICIPACION" class="java.math.BigDecimal"/>
	<field name="BARRA" class="java.math.BigDecimal"/>
	<variable name="totFacturas" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{FACTURAS}]]></variableExpression>
	</variable>
	<variable name="totVentas" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{TOTAL}]]></variableExpression>
	</variable>
